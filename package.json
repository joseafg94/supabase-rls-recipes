{
  "name": "supabase-rls-recipes",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible Supabase Row Level Security reference recipes.",
  "license": "MIT",
  "scripts": {
    "supabase": "supabase",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning --fail-on error",
    "test:db": "supabase test db --local",
    "verify:db": "npm run db:reset && npm run db:lint && npm run test:db",
    "test:catalog": "node scripts/verify-test-catalog.mjs",
    "test:secret-scan": "node scripts/scan-secrets.test.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "verify:ci": "node scripts/verify-ci.mjs",
    "db:stop": "supabase stop"
  },
  "devDependencies": {
    "supabase": "2.115.0"
  },
  "engines": {
    "node": ">=20"
  }
}
